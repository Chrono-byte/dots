2#!/bin/sh

set -eu

if ! command -v makoctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 || ! command -v fuzzel >/dev/null 2>&1; then
    exit 1
fi

refresh_waybar() {
    pkill -RTMIN+8 waybar >/dev/null 2>&1 || true
}

history_json="$(makoctl history -j 2>/dev/null || printf '[]')"

if ! printf '%s' "$history_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
    exit 0
fi

entries_file="$(mktemp)"
menu_file="$(mktemp)"
trap 'rm -f "$entries_file" "$menu_file"' EXIT INT HUP TERM

printf '%s' "$history_json" | jq -r '
    def scalar:
      if . == null then ""
      elif type == "string" then .
      elif type == "number" or type == "boolean" then tostring
      elif type == "array" then map(scalar) | join(" ")
      elif type == "object" then (.data? // .text? // .value? // "") | scalar
      else ""
      end;
    def clean:
      scalar
      | gsub("[[:space:]]+"; " ")
      | sub("^ "; "")
      | sub(" $"; "");
    def pickpaths($paths):
      . as $obj
      | reduce $paths[] as $path (null; . // ($obj | getpath($path) // empty));
    def desktop_name:
      pickpaths([
        ["desktop-entry"],
        ["desktop_entry"],
        ["data", "desktop-entry"],
        ["data", "desktop_entry"]
      ])
      | clean
      | sub("\\.desktop$"; "")
      | split(".")
      | last
      | gsub("[-_]"; " ");
    def titlecase:
      split(" ")
      | map(if . == "" then empty else (.[0:1] | ascii_upcase) + (.[1:] | ascii_downcase) end)
      | join(" ");
    def timestamp:
      pickpaths([
        ["time"],
        ["timestamp"],
        ["created-at"],
        ["created_at"],
        ["data", "time"],
        ["data", "timestamp"]
      ]);
    def format_time:
      timestamp as $ts
      | if $ts == null or $ts == "" then ""
        elif ($ts | type) == "number" then
          if $ts > 1000000000000 then ($ts / 1000 | floor | strftime("%Y-%m-%d %H:%M"))
          else ($ts | strftime("%Y-%m-%d %H:%M"))
          end
        else ($ts | scalar | clean)
        end;
    def truncate($limit):
      if length > $limit then .[0:($limit - 3)] + "..." else . end;

    reverse
    | .[:40]
    | .[]
    | . as $notification
    | ($notification | pickpaths([
        ["app-name"],
        ["app_name"],
        ["app"],
        ["data", "app-name"],
        ["data", "app_name"]
      ]) | clean) as $app
    | ($notification | desktop_name) as $desktop_name
    | ($notification | pickpaths([
        ["summary"],
        ["title"],
        ["data", "summary"],
        ["data", "title"]
      ]) | clean) as $summary
    | ($notification | pickpaths([
        ["body"],
        ["message"],
        ["text"],
        ["data", "body"],
        ["data", "message"],
        ["data", "text"]
      ]) | clean) as $body
    | ($notification | format_time) as $time
    | ($notification | pickpaths([
        ["category"],
        ["data", "category"]
      ]) | clean) as $category
    | ($notification | pickpaths([
        ["urgency"],
        ["data", "urgency"]
      ]) | clean) as $urgency
    | (
        if $desktop_name != "" then ($desktop_name | titlecase)
        elif $app != "" then $app
        else "Unknown App"
      end
    ) as $display_app
    | (if $summary != "" then $summary else "(no title)" end) as $display_summary
    | (if $body != "" then $body else "No body text." end) as $display_body
    | (if $urgency == "" or $urgency == "normal" then "" else "[" + ($urgency | ascii_upcase) + "] " end) as $urgency_tag
    | ([
        ((if $time != "" then $time + "  |  " else "" end) + $display_app + "  |  " + $urgency_tag + $display_summary),
        $display_body,
        (if $category != "" then "type: " + $category else empty end)
      ] | join("  |  ")) as $line
    | [
        ($line | truncate(240))
      ]
    | @tsv
' >"$entries_file"

{
    printf '%s\n' 'Restore latest dismissed notification'
    printf '%s\n' 'Dismiss active notifications'
    if [ -s "$entries_file" ]; then
        cut -f1 "$entries_file" | nl -w2 -s'  '
    else
        printf '%s\n' 'No notification history'
    fi
} >"$menu_file"

selection="$(fuzzel --dmenu --prompt='Notifications: ' <"$menu_file" || true)"
[ -n "${selection:-}" ] || exit 0

case "$selection" in
    "Restore latest dismissed notification")
        makoctl restore >/dev/null 2>&1 || true
        refresh_waybar
        exit 0
        ;;
    "Dismiss active notifications")
        makoctl dismiss --all >/dev/null 2>&1 || true
        refresh_waybar
        exit 0
        ;;
    "No notification history")
        exit 0
        ;;
esac
