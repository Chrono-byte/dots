#!/bin/sh

set -eu

if ! command -v makoctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    jq -nc \
        --arg text "" \
        --arg tooltip "Notifications unavailable" \
        --arg class "error" \
        '{text: $text, tooltip: $tooltip, class: $class}'
    exit 0
fi

active_json="$(makoctl list -j 2>/dev/null || printf '[]')"
history_json="$(makoctl history -j 2>/dev/null || printf '[]')"
active_count="$(printf '%s' "$active_json" | jq 'if type == "array" then length else 0 end' 2>/dev/null || printf '0')"
history_count="$(printf '%s' "$history_json" | jq 'if type == "array" then length else 0 end' 2>/dev/null || printf '0')"

if [ "$active_count" -gt 0 ] 2>/dev/null; then
    text=" $active_count"
    tooltip="$active_count active notifications"
    if [ "$history_count" -gt 0 ] 2>/dev/null; then
        tooltip="$tooltip\n$history_count in history"
    fi
    class="active"
elif [ "$history_count" -gt 0 ] 2>/dev/null; then
    text=""
    tooltip="$history_count notifications in history"
    class="has-history"
else
    text=""
    tooltip="No notifications"
    class="empty"
fi

jq -nc \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
