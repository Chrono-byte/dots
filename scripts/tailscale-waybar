#!/bin/sh

set -eu

status_output="$(timeout 2 tailscale status --json 2>&1 || true)"

if printf '%s' "$status_output" | jq -e . >/dev/null 2>&1; then
    online="$(printf '%s' "$status_output" | jq -r '.Self.Online // false')"
    dns_name="$(printf '%s' "$status_output" | jq -r '.Self.DNSName // .Self.HostName // "Tailscale"')"
    tail_ip="$(printf '%s' "$status_output" | jq -r '.TailscaleIPs[0] // .Self.TailscaleIPs[0] // empty')"
    backend_state="$(printf '%s' "$status_output" | jq -r '.BackendState // "Unknown"')"

    if [ "$online" = "true" ]; then
        text="󰖂"
        class="connected"
        tooltip="Tailscale connected"
        if [ -n "$dns_name" ]; then
            tooltip="$tooltip\n$dns_name"
        fi
        if [ -n "$tail_ip" ]; then
            tooltip="$tooltip\n$tail_ip"
        fi
    else
        text="󰣽"
        class="disconnected"
        tooltip="Tailscale $backend_state"
        if [ -n "$dns_name" ] && [ "$dns_name" != "null" ]; then
            tooltip="$tooltip\n$dns_name"
        fi
    fi
else
    case "$status_output" in
        "")
            text="󰣽"
            class="stopped"
            tooltip="Tailscale unavailable"
            ;;
        *"not running"*|*"Failed to connect"*|*"operation not permitted"*|*"dial unix"*|*"local tailscaled"*|*"timed out"*)
            text="󰣽"
            class="stopped"
            tooltip="Tailscale unavailable"
            ;;
        *)
            text="󰣽"
            class="error"
            tooltip="Tailscale status error"
            ;;
    esac
fi

jq -cn \
    --arg text "$text" \
    --arg class "$class" \
    --arg tooltip "$tooltip" \
    '{text:$text,class:$class,tooltip:$tooltip}'
