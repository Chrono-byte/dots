{
    "workbench.colorTheme": "Better Selenized Dark",
    "files.simpleDialog.enable": true,
    "vscord.app.name": "",
    "vscord.status.idle.disconnectOnIdle": true,
    "workbench.sideBar.location": "right",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.renderWhitespace": "boundary",
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/node_modules": true,
        "**/target": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/target": true
    },
    "breadcrumbs.enabled": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[toml]": {
        "editor.defaultFormatter": "tombi-toml.tombi"
    },
    "gitlens.ai.model": "gitkraken",
    "gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
    "workbench.preferredDarkColorTheme": "Better Selenized Dark",
    "workbench.preferredLightColorTheme": "Better Selenized Light",
    "[typescriptreact]": {
        "editor.defaultFormatter": "TypeScriptTeam.native-preview"
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[javascript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    
    "extensions.ignoreRecommendations": true,
    "editor.lightbulb.enabled": "on",
    "editor.codeActions.triggerOnFocusChange": true,
    "remote.SSH.remotePlatform": {
        "192.168.1.23": "linux",
        "192.168.1.17": "linux"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "window.titleBarStyle": "custom",
    "extensions.gallery.serviceUrl": "https://marketplace.visualstudio.com/_apis/public/gallery",
    "extensions.autoCheckUpdates": true,
    "extensions.autoUpdate": true,
    "extensiontotal.apiKeySetting": ""
}