{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 8,
  "margin-top": 8,
  "margin-left": 3,
  "margin-right": 3,
  "modules-left": [
    "custom/activities",
    "niri/workspaces",
    "custom/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/notifications",
    "tray",
    "custom/tailscale",
    "network",
    "pulseaudio",
    "battery"
  ],
  "custom/activities": {
    "format": "Activities",
    "tooltip": false,
    "on-click": "niri msg action toggle-overview"
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "empty": ""
    }
  },
  "custom/window": {
    "exec": "~/.local/bin/window-title-waybar",
    "return-type": "json",
    "interval": 0,
    "tooltip": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/tailscale": {
    "exec": "~/.local/bin/tailscale-waybar",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/.local/bin/tailscale-menu"
  },
  "custom/notifications": {
    "exec": "~/.local/bin/notifications-waybar",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "on-click": "~/.local/bin/notifications-menu"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "ghostty --class=com.chrono.NetworkManager --title='Network Manager' -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span weight='bold'>{}</span>",
        "days": "{}",
        "weeks": "<span color='#77767b'>{}</span>",
        "weekdays": "<span color='#77767b'>{}</span>",
        "today": "<span weight='bold' underline='single'>{}</span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
