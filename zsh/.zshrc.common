# Portable interactive Zsh configuration shared by Linux and macOS.

unalias aiusage 2>/dev/null
function aiusage() {
  if [[ "$OSTYPE" == linux* ]] && command -v systemctl >/dev/null 2>&1 \
    && [[ -e "$HOME/.config/systemd/user/codex-cloud-usage.service" ]]; then
    systemctl --user start codex-cloud-usage.service 2>/dev/null
  fi
  local cloud_sessions="$HOME/.local/share/aiusage/codex-cloud/sessions"
  local history_sessions="$HOME/.local/share/aiusage/codex-account-estimates/sessions"
  local history_scan=""
  case "$1" in
    submit|autosubmit|import|login|logout|delete-submitted-data) ;;
    *)
      history_scan=",codex:$history_sessions"
      if [[ -x "$HOME/.local/bin/aiusage-account-backfill" ]]; then
        "$HOME/.local/bin/aiusage-account-backfill" --refresh >/dev/null || \
          print -u2 "aiusage: history refresh failed; using the last estimates."
      fi
      ;;
  esac
  TOKSCALE_EXTRA_DIRS="${TOKSCALE_EXTRA_DIRS:+$TOKSCALE_EXTRA_DIRS,}codex:$cloud_sessions$history_scan" \
    bunx tokscale@latest "$@"
}


# Make a user-installed fnm visible before Oh My Zsh loads its plugin.
typeset -U path PATH
FNM_PATH="$HOME/.local/share/fnm"
[[ -d "$FNM_PATH" ]] && path=("$FNM_PATH" $path)
export PATH
zstyle ':omz:plugins:fnm' autostart yes

# Oh My Zsh is shared; each OS wrapper supplies its own `plugins` list.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="" # Starship renders the prompt.
fpath=("$HOME/.zsh/completions" $fpath)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 "Warning: Oh My Zsh is not installed at $ZSH"
  autoload -Uz compinit && compinit
fi

# Shell behavior
unsetopt BEEP
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt CORRECT EXTENDED_GLOB NO_BEEP NOTIFY
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS HIST_IGNORE_SPACE HIST_VERIFY INC_APPEND_HISTORY

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# Search history with Up/Down when the widget is supplied by Oh My Zsh.
if (( $+widgets[history-substring-search-up] )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey -M vicmd 'k' history-substring-search-up
  bindkey -M vicmd 'j' history-substring-search-down
fi
bindkey '\e[1;3D' backward-word
bindkey '\e[1;3C' forward-word

# Portable tool paths. Zsh keeps duplicate entries out of PATH.
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/.local/share/pnpm"
path=(
  "$HOME/.local/bin"
  "$HOME/.local/opt/node/bin"
  "$HOME/.cargo/bin"
  "$BUN_INSTALL/bin"
  "$PNPM_HOME"
  "$HOME/.deno/bin"
  "$HOME/.opencode/bin"
  "$HOME/.npm-global/bin"
  $path
)
export PATH

export DOTFILES_CONFIG="$HOME/.dotfiles/config.toml"

# Use the same prompt and theme on both operating systems.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Prefer Zed locally and a terminal editor over SSH.
export EDITOR="nano"
export VISUAL="$EDITOR"
if [[ -z "$SSH_CONNECTION" ]] && command -v zed >/dev/null 2>&1; then
  export EDITOR="zed --wait"
  export VISUAL="$EDITOR"
fi

# Portable aliases; OS-specific color flags stay in each wrapper.
alias ll='ls -lh'
alias la='ls -lah'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Load slower completions after the first prompt.
zmodload zsh/sched
[[ -f "$HOME/.zshrc.lazy" ]] && sched +0 'source "$HOME/.zshrc.lazy"'
