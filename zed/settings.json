// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "diff_view_style": "unified",
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "relative_line_numbers": "disabled",
  "ssh_connections": [
    {
      "host": "192.168.1.23",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ellie"
          ]
        },
        {
          "paths": [
            "/home/ellie/docker-compose-nas"
          ]
        }
      ]
    },
    {
      "host": "100.105.82.36",
      "username": "ellie",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ellie/docker-compose-nas"
          ]
        }
      ]
    },
    {
      "host": "horus-linux",
      "username": "chrono",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/chrono/Dev/spotmitm"
          ]
        }
      ]
    }
  ],
  "inlay_hints": {
    "enabled": true
  },
  "formatter": "language_server",
  "format_on_save": "off",
  "tabs": {
    "file_icons": false
  },
  "minimap": {
    "show": "auto"
  },
  "vim_mode": false,
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "sort_by_path": true
  },
  "ui_font_weight": 500.0,
  "agent": {
    "flexible": false,
    "default_width": 315.0,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cargo\\s+run(\\s|$)"
            }
          ]
        }
      }
    },
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": false
    },
    "dock": "left",
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
      "enable_thinking": true
    },
    "commit_message_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
      "effort": "low"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "prettier": {
    "allowed": false
  },
  "languages": {
    "Rust": {
      "prettier": {
        "allowed": false
      }
    },
    "TypeScript": {
      "language_servers": ["!typescript-language-server", "vtsls", "!eslint", "..."]
    },
    "TSX": {
      "language_servers": ["!typescript-language-server", "vtsls", "!eslint", "..."]
    }
  },
  "language_servers": ["!eslint", "..."],
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  "context_servers": {},
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-luna"
      },
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "dock": "right"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "VSCode",
  "use_system_path_prompts": true,
  "autosave": "on_focus_change",
  "show_whitespaces": "boundary",
  "hard_tabs": false,
  "tab_size": 2,
  "telemetry": {
    "diagnostics": true,
    "metrics": true
  },
  "edit_predictions": {},
  "ui_font_size": 16.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Flexoki Dark"
  }
}
