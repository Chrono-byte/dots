// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "format_on_save": "off",
    "tabs": {
        "file_icons": false
    },
    "disable_ai": false,
    "minimap": {
        "show": "always"
    },
    "vim_mode": false,
    "git_panel": {
        "tree_view": true,
        "sort_by_path": false
    },
    "ui_font_weight": 500.0,
    "agent": {
        "default_profile": "write",
        "dock": "left",
        "inline_assistant_model": {
            "provider": "copilot_chat",
            "model": "gpt-5.1-codex-mini"
        },
        "play_sound_when_agent_done": true,
        "always_allow_tool_actions": true,
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-5-mini"
        },
        "model_parameters": []
    },
    "prettier": {
        "allowed": false,
    },
    "languages": {
        "Rust": {
            "prettier": {
                "allowed": false,
            },
        },
    },
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "checkOnSave": true,
                "check": {
                    "command": "clippy"
                }
            },
        },
    },
    "context_servers": {},
    "buffer_font_family": "JetBrains Mono",
    "agent_servers": {
        "github-copilot": {
            "type": "registry"
        },
        "opencode": {
            "type": "registry"
        }
    },
    "project_panel": {
        "hide_hidden": false,
        "hide_root": true,
        "dock": "right",
    },
    "title_bar": {
        "show_user_menu": false,
        "show_user_picture": false,
        "show_menus": false,
        "show_sign_in": false,
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "base_keymap": "VSCode",
    "use_system_path_prompts": true,
    "autosave": "on_focus_change",
    "show_whitespaces": "boundary",
    "hard_tabs": false,
    "tab_size": 4,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "edit_predictions": {},
    "ui_font_size": 16.0,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Kanagawa Wave",
    },
}
