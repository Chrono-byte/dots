[Unit]
Description=Niri dynamic floating rules helper
Documentation=https://github.com/YaLTeR/niri/wiki/IPC
After=niri.service
BindsTo=niri.service
PartOf=niri.service

[Service]
Type=simple
ExecStart=%h/.dotfiles/scripts/niri-dynamic-float
Restart=always
RestartSec=2

[Install]
WantedBy=niri.service
