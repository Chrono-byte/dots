layout {

    focus-ring {
        active-color   "#8b7ec8"
        inactive-color "#100f0f"
        urgent-color   "#d14d41"
    }

    border {
        active-color   "#8b7ec8"
        inactive-color "#100f0f"
        urgent-color   "#d14d41"
    }

    shadow {
        color "#100f0f70"
    }

    tab-indicator {
        active-color   "#8b7ec8"
        inactive-color "#2f2172"
        urgent-color   "#d14d41"
    }

    insert-hint {
        color "#8b7ec880"
    }
}

recent-windows {
    highlight {
        active-color "#8b7ec8"
        urgent-color "#d14d41"
    }
}
