input {
    mod-key "Alt"

    mouse {
        accel-speed -0.4
    }
}

// GNOME media keys use explicit modifiers so game mode does not change them.
binds {
    XF86AudioPlay repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "toggle"; }
    Ctrl+XF86AudioPlay repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "pause"; }
    XF86AudioStop repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioNext repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "next"; }
    Ctrl+XF86AudioNext repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "previous"; }
    Ctrl+XF86AudioPrev repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "media" "previous"; }

    XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%+ && noctalia msg volume-osd"; }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%+ && noctalia msg volume-osd"; }
    Alt+XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%+ && noctalia msg volume-osd"; }
    Alt+Ctrl+XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%+ && noctalia msg volume-osd"; }
    Shift+XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 1%+ && noctalia msg volume-osd"; }
    Ctrl+Shift+XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 1%+ && noctalia msg volume-osd"; }
    XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%- && noctalia msg volume-osd"; }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%- && noctalia msg volume-osd"; }
    Alt+XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%- && noctalia msg volume-osd"; }
    Alt+Ctrl+XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 6%- && noctalia msg volume-osd"; }
    Shift+XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 1%- && noctalia msg volume-osd"; }
    Ctrl+Shift+XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 1%- && noctalia msg volume-osd"; }
    XF86AudioMute repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "volume-mute"; }
    Alt+XF86AudioMute repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute repeat=false allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "mic-mute"; }
}

// Generated by niri-game-mode; never changes this host's saved preferences.
include optional=true "~/.local/state/niri/game-mode.kdl"
